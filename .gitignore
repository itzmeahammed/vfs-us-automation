# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Runtime artifacts
app.log
# Per-day archive logs (logs/app-YYYY-MM-DD.log)
logs/
screenshots/
# Windows Task Scheduler wrapper + test logs
task_runner.log
task_stdout.log
task_stderr.log
*_err.log
# Per-account health / cooldown state (circuit breaker)
account_health.json
account_health.json.tmp
# Per-country waitlist-notification cooldown state
waitlist_cooldown.json
waitlist_cooldown.json.tmp
# Daily metered-proxy usage counter + alert flags
bandwidth_budget.json
bandwidth_budget.json.tmp
# Waitlist registration journal (what was submitted, and when)
state/
# Client files hold PII (passport numbers, DOB) — never commit.
# Only the *.example template is tracked.
config/registrants/*.json
!config/registrants/*.json.example
# Identity DOCUMENTS (passport bio pages) are worse than the JSON: a scan adds
# the photo, MRZ and signature. They belong OUTSIDE this repo entirely (see
# DOCUMENT_STORAGE_TASKS.md) — these rules are a backstop for a stray copy, not
# the primary control. .gitignore only stops UNTRACKED files, so a pre-commit
# hook backs it up in turn.
config/registrants/**/*.png
config/registrants/**/*.jpg
config/registrants/**/*.jpeg
config/registrants/**/*.pdf
documents/
config/documents/
# Proxy lists / credentials — never commit
config/proxylist.txt
proxylist.txt
proxies.local.ini
# Generated analytics report
analytics_report.txt

# Local secret overrides (see VFS_BOT_CONFIG_PATH in the README)
config/config.local.ini
*.local.ini
# Editor backups + temp writes (credentials backups contain real secrets) and
# the standalone proxy tool's rotation state. Both the single rolling '<file>.bak'
# and the old timestamped '<file>.bak-<time>' backups are covered.
*.bak
*.bak-*
*.ini.tmp
.proxy_run.state

# Webhook API: local secrets (shared token) and per-job logs.
# .env.api holds VFSAPI_SECRET_TOKEN — never commit it.
.env.api
logs/api_jobs/

# ngrok. The tracked config (ngrok/ngrok.yml, ngrok/traffic-policy.yml) holds
# NO secrets — the authtoken lives in ngrok's own global config outside the
# repo. Only ignore a local override and the agent log.
ngrok/ngrok.local.yml
ngrok/*.log
