; Optional proxy OVERRIDES. Copy to  config/proxies.local.ini  (gitignored).
;
; The proxy pool normally lives in  config/proxylist.txt  (one proxy per line,
; http://user:pass@host:port, or the provider CSV  IP, PORT, LOGIN, PASSWORD).
; Each account is PINNED to one IP from the pool (account_index mod N) and uses
; it across ALL routes — a stable identity. You usually need nothing in here.
;
; Notes:
;   * Authenticated proxies work: the bot injects auth via a local forwarder
;     (Chrome ignores user:pass on --proxy-server).
;   * Only IPs in a VFS-accepted region (UAE) avoid the 403203 geo-block.
;     Datacenter IPs still risk Cloudflare's bot checks — residential is safest.

; [proxy-pool]
; ; Explicit pool that OVERRIDES proxylist.txt (comma-separated).
; list = http://user:pass@1.2.3.4:50100, http://user:pass@5.6.7.8:50100

[proxy-routes]
; Pin a whole route to one proxy (overrides that route's account pinning).
; AE-ITA = http://user:pass@1.2.3.4:50100
