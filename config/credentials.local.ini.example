; Multiple VFS accounts, rotated by clock hour PER ROUTE.
;
; Copy this file to  config/credentials.local.ini  (gitignored) and fill in real
; accounts. Add as many [credN] sections as you like, in order.
;
; routes (optional): the routes this account is registered on, comma-separated
; (keys from config/vfs_urls.ini, e.g. AE-CHE). OMIT the line if the account is
; registered on ALL routes. Each route rotates through its own eligible
; accounts: at the first run hour of the day (06:00) a route uses the first
; account eligible for it, at 07:00 the second, wrapping after the last one.
; Both runs within an hour (e.g. :29 and :59) use the same account. Different
; routes may use different accounts in the same run - that's expected.
;
; A route no account covers is SKIPPED (shown in the Telegram summary).
;
; OTP note: on routes flagged "otp": true (config/routes/<ROUTE>.json), the OTP
; email is fetched from THIS SAME email + password over IMAP ([otp] section in
; config.ini) - so each account's mailbox password must equal its VFS password.
;
; If config/credentials.local.ini does not exist, the bot falls back to the
; single [vfs-credential] account in config.ini / config.local.ini.
;
; Verify after editing (a malformed file breaks the whole bot):
;   .venv/bin/python -c "from src.utils.config_reader import initialize_config as i; i(); from src.utils import credentials as c; [print(h,'cred'+str(x),e) for h,x,e in c.rotation_schedule('AE-CHE')]"

[cred1]
email = account1@example.com
password = your-password-1
routes = AE-CHE, AE-CZE

[cred2]
email = account2@example.com
password = your-password-2
; no routes line -> registered on ALL routes

[cred3]
email = account3@example.com
password = your-password-3
routes = AE-ITA



