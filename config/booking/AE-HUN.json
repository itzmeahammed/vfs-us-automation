{
  "_comment": "UAE -> Hungary booking flow. Built from AE-SWE's proven config (full walk 2026-10-15).",

  "extends": "_default",
  "enabled": true,

  "steps": [
    {
      "name": "start_booking",
      "type": "start_booking",
      "entry": "new",
      "submit": {
        "selector": "button:has-text('Start New Booking')"
      },
      "before": "appointment_details"
    },
    {
      "name": "appointment_details",
      "type": "form",
      "url_contains": "application-detail",
      "fields": [
        {
          "name": "centre",
          "label": "Choose your Application Centre",
          "widget": "mat-select",
          "value": "{{centre}}",
          "required": true,
          "control": "centerCode"
        },
        {
          "name": "category",
          "label": "Choose your appointment category",
          "widget": "mat-select",
          "value": "{{category}}",
          "required": true,
          "control": "selectedSubvisaCategory"
        },
        {
          "name": "sub_category",
          "label": "Choose your sub-category",
          "widget": "mat-select",
          "value": "{{sub_category}}",
          "required": true,
          "control": "visaCategoryCode"
        }
      ],
      "submit": {
        "role": "button",
        "name": "Continue"
      },
      "pre_submit_js": "document.querySelectorAll('button[disabled]').forEach(b => { b.removeAttribute('disabled'); b.classList.remove('mat-mdc-button-disabled'); b.disabled = false; })",
      "_comment_pre_submit_js": "Force-enable Continue when no slots are shown. Needed to walk past this page and capture the remaining pages' DOM."
    },
    {
      "name": "your_details",
      "type": "form",
      "after": "appointment_details",
      "url_contains": "your-details",
      "fields": [
        {
          "name": "first_name",
          "label": "First Name",
          "widget": "text",
          "value": "{{first_name|upper}}",
          "required": true
        },
        {
          "name": "last_name",
          "label": "Last Name",
          "widget": "text",
          "value": "{{last_name|upper}}",
          "required": true
        },
        {
          "name": "gender",
          "label": "Gender",
          "widget": "mat-select",
          "value": "{{gender}}",
          "required": true,
          "if_present": true,
          "exact": true
        },
        {
          "name": "date_of_birth",
          "label": "Date Of Birth",
          "widget": "date",
          "value": "{{date_of_birth|date:%d/%m/%Y}}",
          "required": true,
          "if_present": true
        },
        {
          "name": "nationality",
          "label": "Current Nationality",
          "widget": "mat-select",
          "value": "{{nationality}}",
          "required": true,
          "if_present": true
        },
        {
          "name": "passport_number",
          "label": "Passport Number",
          "widget": "text",
          "value": "{{passport_number|upper}}",
          "required": true
        },
        {
          "name": "passport_expiry",
          "label": "Passport Expiry Date",
          "widget": "date",
          "value": "{{passport_expiry|date:%d/%m/%Y}}",
          "required": true,
          "if_present": true
        },
        {
          "name": "phone_country_code",
          "label": "Contact number",
          "widget": "text",
          "index": 0,
          "value": "{{phone_country_code}}",
          "required": true
        },
        {
          "name": "phone_number",
          "label": "Contact number",
          "widget": "text",
          "index": 1,
          "value": "{{phone_number}}",
          "required": true
        },
        {
          "name": "email",
          "label": "Email",
          "widget": "text",
          "value": "{{email}}",
          "required": true
        }
      ],
      "dwell_seconds": 5,
      "submit": {
        "role": "button",
        "name": "Save"
      }
    },
    {
      "name": "details_summary",
      "type": "form",
      "after": "your_details",
      "url_contains": "your-details",
      "fields": [],
      "wait_for_text": ["Add another applicant", "Your Details Summary"],
      "submit": {
        "role": "button",
        "name": "Continue"
      }
    },
    {
      "name": "select_slot",
      "type": "slot_pick",
      "after": "details_summary",
      "url_contains": "book-appointment",
      "appointment_type": {
        "label": "Choose a slot",
        "if_present": true
      },
      "calendar": {
        "container": "full-calendar",
        "month_title": ".fc-toolbar-title",
        "next_month": "button.fc-next-button",
        "prev_month": "button.fc-prev-button",
        "available_day": "td.fc-daygrid-day.date-availiable",
        "day_date_attribute": "data-date"
      },
      "time_slots": {
        "container": "table.ba-slot-table",
        "row": "tr.hidden-item",
        "time_cell": "td[id^='tv']",
        "select": "label.ba-slot-radio-label",
        "select_inner": "div.ba-slot-radio-label-text1"
      },
      "submit": {
        "role": "button",
        "name": "Continue"
      },
      "commits": false,
      "strategy": "earliest",
      "pre_submit_js": "document.querySelectorAll('button[disabled]').forEach(b => { b.removeAttribute('disabled'); b.classList.remove('mat-mdc-button-disabled'); b.disabled = false; })"
    },
    {
      "name": "services",
      "type": "form",
      "after": "select_slot",
      "url_contains": "services",
      "fields": [],
      "submit": {
        "role": "button",
        "name": "Continue"
      }
    },
    {
      "name": "review_pay",
      "type": "form",
      "after": "services",
      "commits": false,
      "url_contains": "review-pay",
      "fields": [
        {
          "name": "accept_terms",
          "label": "I accept the",
          "widget": "checkbox",
          "value": true,
          "required": true,
          "wrapper": "div.ot-checkbox"
        },
        {
          "name": "marketing_consent",
          "label": "Yes, I agree to receive future communication",
          "widget": "checkbox",
          "value": false,
          "required": false,
          "if_present": true,
          "wrapper": "div.ot-checkbox"
        }
      ]
    },
    {
      "name": "payment",
      "type": "payment",
      "after": "review_pay",
      "processor": "CYBERSOURCE_UC",
      "_comment_processor": "Hungary pays through CyberSource UNIFIED CHECKOUT on online.vfsglobal.com/PG-Component/Payment/CyberSourceNew, not Norway's secureacceptance page — observed on run 6ad9ecb3893138 (2026-10-22) and in the operator's capture (docs/hungary_payment.txt/payment_selector.txt). Selectors: config/payment/CYBERSOURCE_UC.json. HUN ONLY — every other route stays on CYBERSOURCE.",
      "commits": true,
      "submit": {
        "selector": "button#trigger"
      },
      "disclaimer": {
        "role": "button",
        "name": "Continue"
      }
    },
    {
      "name": "confirmation",
      "remove": true
    }
  ]
}
